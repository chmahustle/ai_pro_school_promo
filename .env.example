# Публичный URL сайта (для canonical, OG, sitemap)
NEXT_PUBLIC_SITE_URL=https://ai-pro-school.kz

# Показывать бейджи PLACEHOLDER на незаполненных данных (по умолчанию — только в dev)
# NEXT_PUBLIC_SHOW_PLACEHOLDERS=true

# --- Аналитика (оставьте пустым, чтобы отключить) ---
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_TIKTOK_PIXEL_ID=
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_YM_ID=

# --- Приём заявок (серверная сторона, см. src/lib/leads/) ---
# Адаптер: mock | webhook | telegram
LEADS_ADAPTER=mock
# webhook: amoCRM / Bitrix24 / Make / n8n — любой URL, принимающий JSON POST
LEADS_WEBHOOK_URL=
LEADS_WEBHOOK_SECRET=
# telegram: бот присылает заявки в чат
LEADS_TELEGRAM_BOT_TOKEN=
LEADS_TELEGRAM_CHAT_ID=
