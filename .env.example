# Публичный URL сайта (для canonical, OG, sitemap)
NEXT_PUBLIC_SITE_URL=https://ai-pro-school.kz

# Заглушки/бейджи PLACEHOLDER показываются только в `next dev`. NEXT_PUBLIC_SHOW_PLACEHOLDERS в проде игнорируется,
# а при значении true сборка падает (scripts/check-env.mjs) — не задавайте эту переменную.

# --- Аналитика (оставьте пустым, чтобы отключить) ---
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_TIKTOK_PIXEL_ID=
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_YM_ID=

# Аналитика грузится только в production (в dev скрипты не подключаются); каждая система — только если задан её ID.
# Яндекс.Метрика подключается с вебвизором; поля ввода (имя, телефон) в записи не попадают (класс ym-disable-keys).

# --- Meta Conversions API (серверная отправка Lead/Contact, только на сервере; НЕ NEXT_PUBLIC_) ---
# Токен доступа из Events Manager → Settings → Conversions API. Нет токена — события тихо пропускаются.
META_CAPI_TOKEN=
# Необязательно: код из Events Manager → Test Events (только для проверки; в боевом окружении удалить)
META_TEST_EVENT_CODE=

# --- Приём заявок (серверная сторона, см. src/lib/leads/) ---
# Адаптер: mock | webhook | telegram
LEADS_ADAPTER=mock
# webhook: amoCRM / Bitrix24 / Make / n8n — любой URL, принимающий JSON POST
LEADS_WEBHOOK_URL=
LEADS_WEBHOOK_SECRET=
# telegram: бот присылает заявки в чат
LEADS_TELEGRAM_BOT_TOKEN=
LEADS_TELEGRAM_CHAT_ID=
